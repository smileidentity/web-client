{
  "name": "@smileid/web",
  "version": "11.6.2",
  "description": "A collection of SmileID browser clients and components",
  "main": "index.js",
  "private": true,
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preinstall": "[ \"$npm_config_global\" = \"true\" ] || [ \"$ALLOW_INSTALL\" = \"1\" ] || [ \"$CI\" = \"true\" ] || [ \"$npm_command\" = \"ci\" ] || (echo \"Use npm ci\" && exit 1)"
  },
  "keywords": [
    "Web",
    "Components",
    "Web",
    "Embed",
    "SmileID"
  ],
  "author": "SmileID <support@usesmileid.com> (https://usesmileid.com)",
  "workspaces": [
    "packages/web-components/*/*",
    "packages/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@storybook/addon-essentials": "^8.2.7",
    "@storybook/addon-links": "^8.2.7",
    "@storybook/blocks": "^8.2.7",
    "@storybook/web-components": "^8.2.7",
    "@storybook/web-components-vite": "^8.6.8",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "check-dependency-version-consistency": "^4.1.0",
    "eslint": "^10.9.1",
    "prettier": "^3.3.3",
    "storybook": "^8.6.17"
  },
  "dependencies": {
    "sst": "3.9.28"
  },
  "overrides": {
    "eslint-config-airbnb-base": {
      "eslint": "$eslint",
      "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.17.1"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
